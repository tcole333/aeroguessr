# Settings for a self-hosted AeroGuessr. Save this file as .env next to compose.yaml.
# docs/self-hosting.md explains each one. The repo's root .env.example lists every setting
# the backend reads, and backend/settings.py has their defaults.

# --- Release ---
# The image version to run. Change it to update (docs/self-hosting.md#updating).
AEROGUESSR_VERSION=0.1.0-alpha.1

# --- Web ---
# The port the game is served on. Not 80, which a feeder's web interface (PiAware, adsb.im)
# often holds; set 80 if nothing else uses it.
HTTP_PORT=8088

# --- Your receiver ---
# Your antenna's position, in decimal degrees. The map opens there, and planes farther than
# MAX_ANTENNA_RANGE_KM from it leave the map. Browsers see it rounded to about 1 km; to keep
# even that private, use a nearby public point such as your airport.
CENTER_LAT=42.3656
CENTER_LON=-71.0096
MAX_ANTENNA_RANGE_KM=250
# The airport rounds are about: a 4-letter ICAO code in capitals, with scheduled airline
# service, near enough that its arrivals and departures fly over your antenna.
MONITORED_AIRPORT_ICAO=KBOS

# Your feeder's SBS (BaseStation) output: dump1090-fa, readsb and ultrafeeder serve it on 30003.
# host.docker.internal is the machine Docker runs on. For a feeder in another container, see
# docs/self-hosting.md#a-feeder-in-docker.
ADSB_HOST=host.docker.internal
ADSB_PORT=30003

# Demo mode: 1 replaces your feeder with generated planes flying in to CENTER_LAT/LON, with
# routes to your airport, and never calls AeroAPI. Use it to try the game before connecting
# a receiver.
FAKE_ADSB=0
FAKE_ADSB_FILE=synthetic

# --- Routes (FlightAware AeroAPI) ---
# A plane is playable once its route is known, so live rounds need a key; demo mode doesn't.
# Routes come from your airport's AeroAPI arrival and departure boards, fetched only while
# someone is playing. With no key, no request is made. Keys: https://www.flightaware.com/aeroapi/portal
FLIGHTAWARE_API_KEY=
# The monthly spend the daily cap is derived from. Use 10.00 if your FlightAware account gets
# the ADS-B feeder credit.
AEROAPI_MONTHLY_BUDGET_USD=5.00
