# Settings for the AeroGuessr backend (API and ingest).
#
# Native runs read the repo-root .env (copy this file to .env); variables already set in the
# environment win over it. Containers get their environment from infra/docker-compose.yml.
# backend/settings.py defines every setting; tests/backend/test_settings.py checks that each
# one appears here. Values below are the code defaults unless a comment says otherwise. An
# empty value counts as unset: an empty environment variable falls back to this file, and an
# empty value here to the default.

# --- Shared ---
REDIS_URL=redis://localhost:6379/0
# Seconds a Redis connect, and each send or reply, may take before the call fails, so a
# connection that stopped answering can't stall a caller forever. Redis on the same host
# answers in milliseconds.
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
# Ingest log level (DEBUG, INFO, WARNING, ...). AeroAPI usage is logged at INFO.
LOG_LEVEL=INFO

# --- Ingest: ADS-B feed ---
# dump1090's SBS-1 output. On the Pi, Compose points ADSB_HOST at the Docker host.
ADSB_HOST=127.0.0.1
ADSB_PORT=30003
# The receiver's location: the origin of the position smoother, the centre of the range
# filter below, where the map opens and where demo planes fly. Browsers see it rounded to
# 2 decimals (about 1 km); to keep even that private, use a nearby public point such as the
# airport.
CENTER_LAT=42.3656
CENTER_LON=-71.0096
# Seconds a plane stays in Redis after its last update (the broadcast loop drops it sooner;
# see MIN_UPDATE_INTERVAL_SECONDS).
PLANE_TTL_SECONDS=300

# Demo mode: a built-in generator replaces dump1090, and AeroAPI is never called.
# The default is FAKE_ADSB=0; 1 is the usual choice for local development.
FAKE_ADSB=1
# "synthetic" flies generated planes in to CENTER_LAT/LON. Or name an SBS-1 capture (.sbs or
# .sbs.gz) to replay, FAKE_ADSB_SPEED times as fast. Record it near CENTER_LAT/LON: planes
# beyond MAX_ANTENNA_RANGE_KM leave the map.
FAKE_ADSB_FILE=synthetic
FAKE_ADSB_SPEED=1.0
# Number of synthetic planes.
SYN_PLANE_COUNT=3

# --- API ---
# Planes farther than this from CENTER_LAT/LON, or with no update for this many seconds,
# leave the map (unless they are in a live round).
MAX_ANTENNA_RANGE_KM=250
MIN_UPDATE_INTERVAL_SECONDS=60
# /readyz fails once the ingest heartbeat is older than this.
INGEST_HEALTH_THRESHOLD_SECONDS=60
# How long a host who left an empty room stays host before another player may claim it.
HOST_DISCONNECT_CLAIM_WINDOW_SECONDS=120
# Base of the ws_url returned by the join endpoints. Empty means the request's own origin.
# Set it when phones on the LAN reach the API at a different address, e.g. ws://192.168.1.20:8000/
WS_BASE_URL=
# Airport whose rounds are played: a 4-letter uppercase ICAO code. The map labels it, and
# demo planes are routed to it.
MONITORED_AIRPORT_ICAO=KBOS
# The basemap's MapLibre style, sent to every browser (so any key in it is public). The map
# credits OpenFreeMap, so use an OpenFreeMap style (positron, liberty, bright) or a
# self-hosted copy.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# The version the game reports (in-game settings tab, /healthz, GET /api/v0/config), for bug
# reports. Release images set it to their release version (the git tag without its v). Leave
# it unset: the game then reports pyproject.toml's version, plus the git commit when it runs
# from a checkout.
# BUILD_VERSION=

# --- Flight enrichment (FlightAware AeroAPI) ---
# Key from https://www.flightaware.com/aeroapi/portal. Routes come from the monitored
# airport's arrival/departure boards, refreshed a few pages at a time only while someone is
# actually playing. With no key, no AeroAPI request of any kind is made, so leave it empty
# in development. FLIGHTAWARE_API_KEY= set empty in the environment always means "no key",
# even when .env holds one.
FLIGHTAWARE_API_KEY=

# Master switch for AeroAPI board refreshes (1/true/yes/on or 0/false/no/off; any other value
# is a config error and keeps enrichment off). Invalid enrichment settings never stop the
# process; they only keep enrichment off.
ENRICHMENT_ENABLED=true
# Board refreshes stop once no one has created/joined a room, selected a plane, started or
# skipped a round, or guessed for this many minutes.
ENRICHMENT_IDLE_CUTOFF_MINUTES=15

# Spend limits. AeroAPI bills $0.005 per result set (15 records). The daily cap is derived as
# floor(budget * (1 - margin) / 0.005 / 31): $5.00 with a 20% margin gives 25 result sets a
# day. Use 10.00 if the key's account gets the ADS-B feeder credit. A budget above 20.00 is
# allowed but logs a WARNING.
AEROAPI_MONTHLY_BUDGET_USD=5.00
AEROAPI_BUDGET_SAFETY_MARGIN=0.20
# Optional lower daily cap: 0 (off) or 5 up to the derived cap. Any other value keeps
# enrichment off. 5 result sets fill an empty board once.
AEROAPI_DAILY_RESULT_SET_CAP=
# Per-minute limit, 5-10 (one board fill needs 5; the Personal tier allows 10).
AEROAPI_RESULT_SETS_PER_MINUTE=8
