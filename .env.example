# Example Environment Variables for Plane Guessing Game
# Copy this file to .env and fill in the actual values.

# --- Map Configuration ---
# Default center coordinates for the map (Boston Logan Airport area)
CENTER_LAT=42.3656
CENTER_LON=-71.0096

# Tile server URL template for Leaflet map
# Default is OpenStreetMap. See docs/PRD.md#81-map-tiles for alternatives/policy.
OSM_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# --- Backend Services ---
# Connection URL for Redis (used for caching and game state)
REDIS_URL="redis://127.0.0.1:6379/0"

# OpenSky Network API Credentials (for flight data enrichment)
# Required for fetching origin, destination, aircraft type, etc.
# Register at https://opensky-network.org/apidoc/rest.html
OPENSKY_USERNAME="your-opensky-username"
OPENSKY_PASSWORD="your-opensky-password"

# --- Development & Testing ---
# Set to 1 to use the mock ADS-B data generator instead of a live dump1090 feed.
# Useful for development and testing without a live receiver.
FAKE_ADSB=1
FAKE_ADSB_FILE=synthetic
FAKE_ADSB_SPEED=2.0
# --- Kalman Filter Tuning (Optional) ---
# Adjust these values to tune the smoothing of aircraft positions.
# Higher process noise allows for faster changes, higher measurement noise trusts measurements less.
# KALMAN_PROCESS_NOISE=0.01
# KALMAN_MEASUREMENT_NOISE=10.0

# --- Ingest Service Settings ---
# Host and port for the ADS-B data source (e.g., dump1090)
ADSB_HOST=127.0.0.1
ADSB_PORT=30003

# Kalman filter noise parameters (lower means more trust in model/measurement)
KALMAN_PROCESS_NOISE=0.5
KALMAN_MEASUREMENT_NOISE=10.0

# Time-to-live for plane data in Redis (seconds)
PLANE_TTL_SECONDS=300

# Range-based plane filtering settings
# Maximum distance from antenna to consider planes "in range" (km)
MAX_ANTENNA_RANGE_KM=250
# Minimum update interval to consider a plane "active" (seconds)
MIN_UPDATE_INTERVAL_SECONDS=60

FLIGHTAWARE_API_KEY="your-flightaware-api-key"
