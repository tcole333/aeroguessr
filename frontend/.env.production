# Production environment variables for aeroguessr.com
# This file is used during the production build

# API URL - Uses HTTPS via Cloudflare
VITE_API_BASE_URL=https://aeroguessr.com/api/v0

# WebSocket URL - WSS for secure WebSocket via Cloudflare
VITE_WS_BASE_URL=wss://aeroguessr.com

# Map configuration
VITE_MAP_CENTER_LAT=42.3656
VITE_MAP_CENTER_LON=-71.0096

# Optional: Analytics or monitoring
# VITE_ANALYTICS_ID=your-analytics-id
