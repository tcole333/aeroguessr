# The frontend image's server: the game's static files, plus the backend's routes, so a
# browser needs only this container. In the maintainer's stack an nginx in front
# (infra/nginx.conf) routes /api/ to the backend itself, and only page requests reach here.
#
# At startup the nginx image renders this template into /etc/nginx/conf.d/default.conf,
# filling in BACKEND_URL (set in frontend/Dockerfile) and NGINX_LOCAL_RESOLVERS (the
# nameservers in /etc/resolv.conf).

# WebSocket upgrades pass through; other requests close the upstream connection.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# The per-client limit aeroguessr.com applies to the API (infra/nginx.conf).
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;

server {
    # 25-drop-ipv6-listen.sh removes the IPv6 listener when the kernel has no IPv6.
    listen 80;
    listen [::]:80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/css text/plain text/javascript application/javascript application/json image/svg+xml;

    # Resolve the backend on each request, not once at startup: nginx then starts without the
    # backend, and follows it when Compose recreates it at a new address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend "${BACKEND_URL}";

    proxy_http_version 1.1;
    # $http_host keeps the port: the backend builds the WebSocket URL it hands out from it.
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # REST and the game WebSocket. The game's client and the backend exchange pings every 10 s,
    # which keeps an open socket inside nginx's default 60 s read timeout.
    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass $backend;
    }

    location = /healthz {
        proxy_pass $backend;
    }

    # Answers 503 with a JSON reason when the ingest is not heartbeating on its feed.
    location = /readyz {
        proxy_pass $backend;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
